# ProjectAtlas local index — ~31 MB, machine-local, rebuild with `projectatlas init`
.projectatlas/

# Generated by the verify and screenshot scripts on every run (each rm -rf's
# its own first). docs/img/ is NOT here: those are the README's pictures.
tools/verify/prof/
tools/verify/run/
tools/verify/run-desktop/
tools/shots/run/

# Generated MCP config — contains absolute paths to this machine
.mcp.json

# Agent tooling — machine-local settings, notes and skills, whatever tool made
# them. None of it is about this project: the design reference that used to be
# tracked under .claude/ named no file in the repo, and what actually governs
# the motion is written down in docs/architecture.md. .codex/config.toml is a
# generated MCP config full of absolute paths to one machine, like .mcp.json.
.claude/
.agents/
.codex/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/
.directory

# Electron shell — installed by `npm install`, built into dist/
node_modules/
dist/
