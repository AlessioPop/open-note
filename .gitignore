# ProjectAtlas local index — ~31 MB, machine-local, rebuild with `projectatlas init`
.projectatlas/

# Generated by the verify scripts on every run (each rm -rf's its own first)
tools/verify/prof/
tools/verify/run/
tools/verify/run-desktop/

# Generated MCP config — contains absolute paths to this machine
.mcp.json

# Claude Code — machine-local settings and notes. The apple-design skill is the
# one thing here that belongs to the project, so it is kept.
.claude/*
!.claude/skills/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/
.directory

# Electron shell — installed by `npm install`, built into dist/
node_modules/
dist/
